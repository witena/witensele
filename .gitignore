node_modules
out
dist
*.local
.DS_Store

# Playwright output
test-results
playwright-report

# The Node server's data directory (`WITENA_DATA_DIR`): the SQLite file, the
# encryption key, skills and memory. The default is deliberately inside the
# checkout so `npm run server` needs no setup; nothing in it belongs to git.
.witena-data

# Local-only Chinese copies of committed English docs
*.zh.md
CLAUDE.local.md

# Intermediate iconset: build/icon.svg, icon-dark.svg, icon.png and icon.icns are
# committed, the ten sips-generated PNGs that produce the icns are not.
build/icon.iconset

# Generated by scripts/generate-licenses.mjs (Settings -> About); derived from
# node_modules, so it is produced by the pretypecheck / pretest / prebuild hooks
# rather than committed.
src/renderer/src/generated

# Downloaded by scripts/fetch-ant.mjs: the Anthropic CLI shipped inside the app,
# pinned by version and SHA-256 in build/ant-release.json. A binary derived from
# a pinned release is fetched, never committed.
vendor
